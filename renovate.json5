{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'docker:enableMajor',
    ':separateMultipleMajorReleases',
  ],
  enabled: true,
  timezone: 'Europe/Berlin',
  prConcurrentLimit: 6,
  prHourlyLimit: 2,
  prCreation: 'immediate',
  dependencyDashboard: {
    enabled: true,
  },
  labels: [
    'dependencies',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        'SYNAPLAN_IMAGE_DIGEST:\\s*(?:(?<currentValue>[^@\\s]+)@)?(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'ghcr.io/metadist/synaplan',
      datasourceTemplate: 'docker',
      currentValueTemplate: '{{#if currentValue}}{{currentValue}}{{else}}latest{{/if}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        'SYNAPLAN_REF:\\s*(?<currentDigest>[a-f0-9]{40})',
      ],
      depNameTemplate: 'https://github.com/metadist/synaplan',
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
    },
  ],
  packageRules: [
    {
      groupName: 'Frontend Core',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'vue',
        '@vue/**',
        'vite',
        '@vitejs/**',
        'typescript',
        '@typescript-eslint/**',
        'vue-tsc',
        'tailwindcss',
        '@tailwindcss/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'OpenCloud SDK',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        '@opencloud-eu/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'QA & Dev Tools',
      matchPackageNames: [
        '@playwright/test',
        'vitest',
        '@vitest/**',
        'happy-dom',
        'eslint',
        'prettier',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'Go Dependencies',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchPackageNames: [
        'github.com/cs3org/go-cs3apis',
      ],
      enabled: false,
    },
    {
      groupName: 'Docker Images',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'Synaplan',
      matchPackageNames: [
        'ghcr.io/metadist/synaplan',
        'https://github.com/metadist/synaplan',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'minor',
        'patch',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'dependencies',
        'breaking',
      ],
    },
  ],
}
