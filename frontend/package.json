{
  "name": "synaplan-opencloud",
  "version": "0.0.0",
  "private": true,
  "description": "Synaplan integration for OpenCloud",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL_OC=https://host.docker.internal:9201 playwright test"
  },
  "devDependencies": {
    "@opencloud-eu/design-system": "6.1.0",
    "@opencloud-eu/eslint-config": "6.1.0",
    "@opencloud-eu/extension-sdk": "6.1.0",
    "@opencloud-eu/prettier-config": "6.1.0",
    "@opencloud-eu/tsconfig": "6.1.0",
    "@opencloud-eu/web-client": "6.1.0",
    "@opencloud-eu/web-pkg": "6.1.0",
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.0",
    "@vue/compiler-dom": "3.5.42",
    "@vue/server-renderer": "3.5.42",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.0.3",
    "happy-dom": "20.8.9",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "uuid": "13.0.1",
    "vite": "8.0.16",
    "vitest": "3.2.6",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "vue3-gettext": "4.0.0-beta.1",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "@module-federation/vite": "1.14.1"
    }
  }
}
