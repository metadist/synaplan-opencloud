FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523

RUN go install github.com/air-verse/air@v1.64.5

RUN mkdir -p /tmp/go-cache/gopath /tmp/go-cache/build && chmod -R 777 /tmp/go-cache

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 9106
ENTRYPOINT ["air"]
