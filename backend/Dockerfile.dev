FROM golang:1.27-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280

RUN go install github.com/air-verse/air@v1.64.5

RUN mkdir -p /tmp/go-cache/gopath /tmp/go-cache/build && chmod -R 777 /tmp/go-cache

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 9106
ENTRYPOINT ["air"]
